# BulanTanom — backend environment template.
#
# Copy to `backend/.env` and fill in real values. That file is gitignored and
# must never be committed. Nothing here may be prefixed NEXT_PUBLIC_ or copied
# into the Next.js project: every value below is server-side only.

# --- Django core ----------------------------------------------------------
DJANGO_SECRET_KEY=replace-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- MySQL ----------------------------------------------------------------
DB_NAME=bulantanom
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# --- Gemini (server-side only) -------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=20

# --- Frontend origin ------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000
REFRESH_COOKIE_SECURE=False

# SameSite policy for the HttpOnly refresh cookie.
#
# "Lax" is correct whenever the frontend and backend share a registrable
# domain -- localhost during development, or app.example.com talking to
# api.example.com in production.
#
# Split hosting is NOT that. A frontend on *.vercel.app calling a backend on
# *.onrender.com is cross-site, and browsers silently refuse to send a
# SameSite=Lax cookie on those requests: sign-in appears to work, then every
# user is logged out the moment their 15-minute access token expires and the
# refresh call arrives without a cookie.
#
# For that topology set:
#   REFRESH_COOKIE_SAMESITE=None
#   REFRESH_COOKIE_SECURE=True     <- browsers ignore SameSite=None without it
REFRESH_COOKIE_SAMESITE=Lax

# Used to build the login link inside account emails. Must be the real public
# URL in production — a hardcoded localhost produces dead links in real inboxes.
FRONTEND_URL=http://localhost:3000

# --- Email ----------------------------------------------------------------
# Leave EMAIL_HOST empty to use Django's console backend: messages are printed
# to the runserver output and reach no inbox. That is the safe default for
# development, and it is why account emails "do not work" until the values
# below are filled in.
#
# Set EMAIL_HOST to switch to real SMTP delivery.
#
# Gmail note: EMAIL_HOST_PASSWORD must be a 16-character Google App Password,
# not your normal account password. App Passwords require 2-Step Verification
# to be enabled on the account first. A normal password fails with
# SMTPAuthenticationError 535.
#
# Port 587 -> EMAIL_USE_TLS=True  (STARTTLS, the common case)
# Port 465 -> EMAIL_USE_SSL=True  (implicit SSL; turns TLS off automatically)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT_SECONDS=15

# Must be an address the SMTP account is allowed to send as. For Gmail this
# is normally the same address as EMAIL_HOST_USER.
DEFAULT_FROM_EMAIL=BulanTanom <no-reply@bulantanom.local>
